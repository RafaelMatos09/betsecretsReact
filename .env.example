# === Desenvolvimento local (npm run dev) ===
# VITE_API_URL vazio → Vite faz proxy de /api para o backend local
VITE_API_URL=
VITE_API_PROXY_TARGET=http://localhost:5027
VITE_CAMPEONATO_API_URL=/api/campeonato
VITE_CAMPEONATO_PROXY_TARGET=https://campeonatobrasileiroapi.onrender.com

# === Produção (Render) ===
# VITE_API_URL vazio → nginx faz proxy de /api para o backend
# VITE_API_URL=
# VITE_CAMPEONATO_API_URL=/api/campeonato
